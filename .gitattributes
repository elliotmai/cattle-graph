# This repo is edited on Windows and run on Linux, and autocrlf would hand the
# server shell scripts with CRLF endings -- which fail as
# "bad interpreter: /usr/bin/env bash^M" -- and systemd units it mis-parses.
# Pin the deploy artifacts to LF regardless of what the checkout platform wants.
*.sh       text eol=lf
*.service  text eol=lf
*.timer    text eol=lf
*.py       text eol=lf
*.cypher   text eol=lf
*.mjs      text eol=lf

# PowerShell is the exception: it stays CRLF for the Windows box. Note the
# warning in muster's windows-setup.ps1 -- PS 5.1 reads a BOM-less .ps1 as
# ANSI, so non-ASCII in these files breaks parsing.
*.ps1      text eol=crlf

*.png      binary
*.mp4      binary
*.db       binary
