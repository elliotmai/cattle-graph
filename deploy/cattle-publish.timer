# Every 60s. The board shows how long ago the box last reported, so a timer
# that stops is visible on the page rather than silent.
[Unit]
Description=publish cattle-graph status every minute

[Timer]
OnBootSec=90s
OnUnitActiveSec=60s
# Without this a missed window (reboot, suspend) waits for the next tick.
Persistent=true
AccuracySec=5s

[Install]
WantedBy=timers.target
