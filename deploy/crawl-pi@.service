# cattle-graph crawler, Raspberry Pi variant. Instance name IS the association
# code, same as the Lightsail crawl@.service:
#
#   systemctl enable --now crawl-pi@CHIA
#
# Why a Pi at all: the DigitalBeef breed hosts (chianina especially) sit behind
# Cloudflare, which scores datacenter ASNs -- AWS/Lightsail -- far more harshly
# than an ordinary residential ISP address. Running the crawl from home puts it
# behind a residential IP, which is the single biggest lever against being
# challenged or blocked. See deploy/pi-setup.md.
#
# This differs from crawl@.service only where the Pi differs:
#   - User/Group is your Pi login, not `ubuntu` (pi-setup.md fills it in).
#   - ExecStart calls deploy/crawl-run.sh, which builds the crawl.py command and
#     turns on live loading into Aura ONLY when NEO4J_URI is set in the env file.
#     Leave it unset to write data_%i.jsonl only and load elsewhere; set it to
#     load each record into Neo4j as it is fetched. See deploy/pi-setup.md.
#
# Flag choices (in crawl-run.sh) are kept identical to crawl@.service so the Pi
# produces records the dedup loader merges cleanly with what the other crawlers
# wrote:
#   --stay-in-association  keep the CHIA crawler inside Chianina, not walking
#                          the ten other breeds DigitalBeef serves.
#   --skip-steers          match the loader, which passes --skip-steers.
#   --no-epds              drop one of the five requests per animal.
#   --html-store           archive each fetched page (gzip) so a reparse needs
#                          no re-crawl -- the largest avoidable load on their
#                          servers. A few GB per breed; the SD-card note in
#                          pi-setup.md matters here.
#   --ignore-robots        matches the production units. Remove it to honor
#                          robots.txt; the crawler checks it by default.
#
# No --seed: the frontier DB holds the queue and crawl.py drains it. Seed CHIA
# once (or copy an existing frontier_CHIA.db over) per pi-setup.md.

[Unit]
Description=cattle-graph crawler on Pi (%i)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=__CRAWL_USER__
Group=__CRAWL_USER__
WorkingDirectory=/opt/cattle-graph
EnvironmentFile=/etc/cattle-graph.env
# The launcher reads CRAWL_DELAY, CRAWL_UA and the optional NEO4J_* vars from the
# EnvironmentFile and assembles the crawl.py command. %i is the association code.
ExecStart=/opt/cattle-graph/deploy/crawl-run.sh %i

# A blocked or rate-limited association should back off, not hot-loop.
Restart=always
RestartSec=60

# crawl.py exits 75 after --max-blocked consecutive 403/429s. Without this,
# Restart=always would drive the crawler back into the same wall every minute --
# and on a residential line that wall is your home IP. Clear the block (wait it
# out), then start the unit again by hand.
RestartPreventExitStatus=75

# Politeness is the point; never let the crawl starve a small board.
Nice=5

# Logs to journald, which rotates itself. journalctl -u crawl-pi@CHIA -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=crawl-%i

# Light hardening: the crawler needs its own directory and the network only.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/cattle-graph

[Install]
WantedBy=multi-user.target
